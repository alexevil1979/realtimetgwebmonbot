SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite://./data/uptime.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true

# Docker: порт 9080 (80/443 заняты Hiddify). Доступ: http://IP:9080/
UPTIME_BIND=0.0.0.0
UPTIME_PORT=9080
# Initial admin (created only if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
